# ============================================================
# NutriPlan Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Neon, local, or any provider)
DATABASE_URL=Host=localhost;Database=nutriplan_db;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

# ─── JWT Authentication ────────────────────────────────────
# Generate a strong 64+ character secret key for JWT signing.
# Example: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHAR_MINIMUM_SECRET_KEY_HERE

# ─── Gemini AI API Key ─────────────────────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── CORS Allowed Origins ─────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Frontend (Next.js) ───────────────────────────────────
# Backend API URL for Next.js rewrites
BACKEND_URL=http://localhost:5128
